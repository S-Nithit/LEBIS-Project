<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n2" value="Flowchart 3 — Removing an item (remove_item) and returning (return_item)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="115.0" y="10" width="620" height="34" as="geometry" /></mxCell><mxCell id="n3" value="Start: remove" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="125.0" y="60" width="170" height="50" as="geometry" /></mxCell><mxCell id="n4" value="position = index.get(code)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="95.0" y="140" width="230" height="56" as="geometry" /></mxCell><mxCell id="n5" value="Code found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="95.0" y="220" width="230" height="96" as="geometry" /></mxCell><mxCell id="n6" value="Units still&lt;br&gt;with customers?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="95.0" y="345" width="230" height="96" as="geometry" /></mxCell><mxCell id="n7" value="Move the last item of the list&lt;br&gt;into this position" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="95.0" y="470" width="230" height="56" as="geometry" /></mxCell><mxCell id="n8" value="Update the moved item's index&lt;br&gt;to point to its new position" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="95.0" y="555" widt