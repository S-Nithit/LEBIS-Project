<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>

<mxCell id="n2" value="Flowchart 4 — การค้นหา: 3 เส้นทาง (hash · binary · linear)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="10" width="720" height="34" as="geometry"/></mxCell>
<mxCell id="n2b" value="search.py · เลือกเส้นทางตามชนิดของคำถาม แล้วลงรายละเอียด binary_search ซึ่งเป็นตัวที่เขียนเอง" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="55" y="44" width="720" height="20" as="geometry"/></mxCell>

<mxCell id="n3" value="เริ่ม" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="245" y="78" width="170" height="46" as="geometry"/></mxCell>

<mxCell id="n4" value="รับคำถามค้นหาจากหน้าเว็บ&lt;br&gt;(รหัสที่ต้องการ หรือ คำบางส่วนในชื่อ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="138" width="230" height="52" as="geometry"/></mxCell>

<mxCell id="n5" value="ค้นด้วยรหัส&lt;br&gt;ที่ตรงเป๊ะ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="204" width="230" height="86" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;เส้นทางที่ 1 — linear&lt;/b&gt;&lt;br&gt;search_by_name()&lt;br&gt;ไล่ดูทุกชิ้น เทียบคำในชื่อ&lt;br&gt;คืน &lt;b&gt;ทุก&lt;/b&gt; ตัวที่ตรง ไม่ใช่ตัวแรก — O(n)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="212" width="220" height="76" as="geometry"/></mxCell>

<mxCell id="n7" value="มีตารางแฮช&lt;br&gt;พร้อมใช้?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="304" width="230" height="86" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;เส้นทางที่ 2 — hash&lt;/b&gt;&lt;br&gt;hash_lookup(table, code)&lt;br&gt;คำนวณถังแล้วหยิบจากถังนั้นเลย&lt;br&gt;O(1) เฉลี่ย · O(n) ตอนชนกันหมด" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="312" width="220" height="76" as="geometry"/></mxCell>

<mxCell id="n9" value="list เรียงตาม&lt;br&gt;รหัสแล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="404" width="230" height="86" as="geometry"/></mxCell>
<mxCell id="n10" value="sort_by_code() — O(n log n)&lt;br&gt;ลงทุนเรียงครั้งเดียว ค้นซ้ำได้ตลอด&lt;br&gt;&lt;b&gt;ถ้าไม่เรียง การตัดครึ่งจะตัดผิดข้าง&lt;/b&gt;&lt;br&gt;แล้วคืน None ทั้งที่ของอยู่ในนั้น" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="412" width="220" height="76" as="geometry"/></mxCell>

<mxCell id="n11" value="&lt;b&gt;เส้นทางที่ 3 — binary (เขียนเอง)&lt;/b&gt;&lt;br&gt;low = 0 · high = len(items) − 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="504" width="230" height="50" as="geometry"/></mxCell>

<mxCell id="n12" value="low ≤ high?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="568" width="230" height="86" as="geometry"/></mxCell>
<mxCell id="n13" value="คืน None&lt;br&gt;ไม่มีของรหัสนี้อยู่ใน list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="583" width="220" height="56" as="geometry"/></mxCell>

<mxCell id="n14" value="middle = low + (high − low) // 2&lt;br&gt;current = items[middle][&quot;code&quot;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="668" width="300" height="56" as="geometry"/></mxCell>

<mxCell id="n15" value="current == code?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="738" width="230" height="86" as="geometry"/></mxCell>
<mxCell id="n16" value="คืน items[middle]&lt;br&gt;เจอแล้ว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="753" width="220" height="56" as="geometry"/></mxCell>

<mxCell id="n17" value="current &amp;lt; code?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="838" width="230" height="86" as="geometry"/></mxCell>
<mxCell id="n18" value="low = middle + 1&lt;br&gt;ทิ้งครึ่งซ้ายทั้งก้อน" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="853" width="220" height="56" as="geometry"/></mxCell>
<mxCell id="n19" value="high = middle − 1&lt;br&gt;ทิ้งครึ่งขวาทั้งก้อน" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="853" width="185" height="56" as="geometry"/></mxCell>

<mxCell id="n20" value="จบ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="245" y="1020" width="170" height="46" as="geometry"/></mxCell>

<mxCell id="n21" value="&lt;b&gt;ทำไมรอบหนึ่งตัดได้ครึ่งหนึ่ง&lt;/b&gt;  ทุกครั้งที่เทียบจบหนึ่งรอบ จำนวนที่เหลือต้องดูจะลดลงครึ่งหนึ่ง ข้อมูล 1,000 ชิ้นจึงเทียบแค่ประมาณ 10 ครั้ง (2¹⁰ = 1,024)&lt;br&gt;เทียบกับ linear ที่เทียบเฉลี่ย 500 ครั้ง · เขียนเป็นลูป ไม่ใช่เรียกตัวเอง จึงไม่กินพื้นที่ stack เพิ่ม หน่วยความจำเป็น O(1) ไม่ใช่ O(log n)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=#f9f9f9;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="20" y="1090" width="787" height="60" as="geometry"/></mxCell>

