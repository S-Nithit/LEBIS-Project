        <mxCell id="1EbR7DAvwTjFx6VMF4nU-1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" value="Flowchart 7 — Grouping: group_by_type and group_by_status" vertex="1">
