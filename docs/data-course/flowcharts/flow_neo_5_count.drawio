<mxCell id="n2b" value="search.py · ทั้งสามตัวเป็นการเดินผ่านข้อมูลรอบเดียว โครงเหมือนกัน ต่างกันแค่เงื่อนไขที่นับและสิ่งที่บวก" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="25" y="44" width="775" height="20" as="geometry"/></mxCell>

<mxCell id="a1" value="&lt;b&gt;count_available(items)&lt;/b&gt;&lt;br&gt;นับจำนวน &lt;b&gt;ชิ้น&lt;/b&gt; ที่ยังอยู่บนชั้น" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="76" width="230" height="46" as="geometry"/></mxCell>
