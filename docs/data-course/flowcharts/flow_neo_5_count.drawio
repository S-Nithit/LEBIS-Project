<mxCell id="a4" value="ยังมีรายการ&lt;br&gt;ถัดไปไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="276" width="230" height="90" as="geometry"/></mxCell>
