<mxCell id="a5" value="status ≠ broken ?&lt;br&gt;&lt;i&gt;ของชำรุดไม่นับ ถึงจะวางอยู่&lt;br&gt;บนชั้นก็ปล่อยเช่าไม่ได้&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="390" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="b5" value="status เป็นหนึ่งใน&lt;br&gt;3 คีย์ที่รู้จัก?&lt;br&gt;&lt;i&gt;ค่าแปลกปลอมถูกข้ามไป&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="299" y="390" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="c5" value="due_date ไม่ใช่ None&lt;br&gt;&lt;b&gt;และ&lt;/b&gt; due_date &amp;lt; today ?&lt;br&gt;&lt;i&gt;ของที่คืนแล้วไม่มีกำหนด&lt;br&gt;ต้องข้ามก่อนเทียบ&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="573" y="390" width="230" height="110" as="geometry"/></mxCell>

<mxCell id="a6" value="total += item[&quot;available&quot;]&lt;br&gt;&lt;i&gt;บวกเป็นจำนวนชิ้น ไม่ใช่ +1&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="524" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="b6" value="counts[status] += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="299" y="524" width="230" height="60" as="geometry"/></mxCell>
