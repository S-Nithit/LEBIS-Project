<mxCell id="n2" value="Flowchart 5 — Counting: count_available · count_by_status · count_overdue" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="10" width="775" height="34" as="geometry"/></mxCell>
<mxCell id="n2b" value="search.py · All three are a single pass over the data — the same skeleton, differing only in the condition and in what is added" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="25" y="44" width="775" height="20" as="geometry"/></mxCell>

<mxCell id="a1" value="&lt;b&gt;count_available(items)&lt;/b&gt;&lt;br&gt;Count the &lt;b&gt;units&lt;/b&gt; still on the shelf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="76" width="230" height="46" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;b&gt;count_by_status(items)&lt;/b&gt;&lt;br&gt;Count the &lt;b&gt;records&lt;/b&gt; by status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="299" y="76" width="230" height="46" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;count_overdue(items, today)&lt;/b&gt;&lt;br&gt;Count the records past their due date" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="573" y="76" width="230" height="46" as="geometry"/></mxCell>

