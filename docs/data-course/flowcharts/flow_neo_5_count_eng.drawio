<mxCell id="b2" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="329" y="138" width="170" height="44" as="geometry"/></mxCell>
<mxCell id="c2" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="603" y="138" width="170" height="44" as="geometry"/></mxCell>

<mxCell id="a3" value="total = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="200" width="230" height="56" as="geometry"/></mxCell>
<mxCell id="b3" value="counts = { ok: 0, out: 0, broken: 0 }&lt;br&gt;&lt;i&gt;All three keys created up front&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="299" y="200" width="230" height="56" as="geometry"/></mxCell>
<mxCell id="c3" value="count = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="573" y="200" width="230" height="56" as="geometry"/></mxCell>

<mxCell id="a4" value="Another record&lt;br&gt;left?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="276" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="b4" value="Another record&lt;br&gt;left?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="299" y="276" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="c4" value="Another record&lt;br&gt;left?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="573" y="276" width="230" height="90" as="geometry"/></mxCell>

<mxCell id="a5" value="status ≠ broken ?&lt;br&gt;&lt;i&gt;Broken units&lt;br&gt;cannot be rented&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="390" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="b5" value="status is one of&lt;br&gt;the three known keys?&lt;br&gt;&lt;i&gt;Unknown values are skipped&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="299" y="390" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="c5" value="due_date is not None&lt;br&gt;&lt;b&gt;and&lt;/b&gt; due_date &amp;lt; today ?&lt;br&gt;&lt;i&gt;Returned items&lt;br&gt;have no due date&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="573" y="390" width="230" height="110" as="geometry"/></mxCell>

<mxCell id="a6" value="total += item[&quot;available&quot;]&lt;br&gt;&lt;i&gt;Adds a quantity, not 1&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="524" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="b6" value="counts[status] += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="299" y="524" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="c6" value="count += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="573" y="524" width="230" height="60" as="geometry"/></mxCell>

<mxCell id="a7" value="Return total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="660" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="b7" value="Return counts&lt;br&gt;&lt;i&gt;All three keys, always, even at 0&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="299" y="660" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="c7" value="Return count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="573" y="660" width="230" height="60" as="geometry"/></mxCell>

<mxCell id="a8" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="750" width="170" height="44" as="geometry"/></mxCell>
<mxCell id="b8" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="329" y="750" width="170" height="44" as="geometry"/></mxCell>
<mxCell id="c8" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="603" y="750" width="170" height="44" as="geometry"/></mxCell>

<mxCell id="note" value="&lt;b&gt;Why all three are O(n), with no shortcut&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Counting differs from searching: there is &lt;b&gt;no &quot;right one&quot; to stop at&lt;/b&gt;. Every item must be examined before the number is known, so none can be skipped.&lt;br&gt;• Binary search does not apply — halving needs one target that can be compared as greater or smaller, and counting has no such target.&lt;br&gt;• A hash table does not help either: it answers &quot;where is this one&quot;, never &quot;how many satisfy the condition&quot;.&lt;br&gt;• &lt;b&gt;Memory is O(1) for all three&lt;/b&gt; — count_by_status holds three fixed slots, which do not grow with n.&lt;br&gt;• count_by_status produces all three numbers in a &lt;b&gt;single pass&lt;/b&gt; rather than three separate loops, reading the data three times less.&lt;br&gt;• Dates compare correctly as plain strings because YYYY-MM-DD runs from the largest unit to the smallest; stored as DD/MM/YYYY this stops being true at once." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f9f9f9;strokeColor=#cccccc;spacing=10;" vertex="1" parent="1"><mxGeometry x="25" y="840" width="778" height="170" as="geometry"/></mxCell>

