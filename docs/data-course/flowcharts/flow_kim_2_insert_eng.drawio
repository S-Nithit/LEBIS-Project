<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n2" value="Flowchart 2 — Adding an item (add_item + HashTable.insert)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110.0" y="10" width="620" height="34" as="geometry" /></mxCell><mxCell id="n3" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="245.0" y="60" width="170" height="50" as="geometry" /></mxCell><mxCell id="n4" value="Receive a new record&lt;br&gt;(code, name, total, available ...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="135" width="230" height="56" as="geometry" /></mxCell><mxCell id="n5" value="index.get(code)&lt;br&gt;code already exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="215" width="230" height="96" as="geometry" /></mxCell><mxCell id="n6" value="Reject: duplicate code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="235" width="220" height="56" as="geometry" /></mxCell><mxCell id="n7" value="total ≥ 1 and&lt;br&gt;0 ≤ available ≤ total?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="340" width="230" height="96" as="geometry" /></mxCell><mxCell id="n8" value="Reject: invalid quantity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="360" width="220" height="56" as="geometry" /></mxCell><mxCell id="n9" value="Fill missing fields to all 8&lt;br&gt;items.append(record)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="470" width="230" height="56" as="geometry" /></mxCell><mxCell id="n10" value="_hash(code): polynomial rolling hash&lt;br&gt;h = (h × 31 + ord(char)) mod 1e9+7&lt;br&gt;bucket = h mod number of buckets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180.0" y="555" width="300" height="70" as="geometry" /></mxCell><mxCell id="n11" value="Is this code already&lt;br&gt;in the bucket's chain?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="655" width="230" height="96" as="geometry" /></mxCell><mxCell id="n12" value="Overwrite the value (used when moving a position)&lt;br&gt;size unchanged" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="675" width="220" height="56" as="geometry" /></mxCell><mxCell id="n13" value="Bucket empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="780" width="230" height="96" as="geometry" /></mxCell><mxCell id="n14" value="Collision&lt;br&gt;collisions + 1&lt;br&gt;append to the chain (chaining)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="800" width="220" height="66" as="geometry" /></mxCell><mxCell id="n15" value="Put (code, position) in the bucket&lt;br&gt;size + 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="910" width="230" height="56" as="geometry" /></mxCell><mxCell id="n16" value="load factor&lt;br&gt;= size ÷ buckets &gt; 0.7?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="995" width="230" height="96" as="geometry" /></mxCell><mxCell id="n17" value="_resize(): buckets × 2&lt;br&gt;rehash every entry into new buckets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="1015" width="220" height="56" as="geometry" /></mxCell><mxCell id="n18" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="245.0" y="1130" width="170" height="50" as="geometry" /></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" />