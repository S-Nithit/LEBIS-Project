<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36 Edg/141.0.0.0">
  <diagram id="49B17u3zCQfQJgj0rsEh" name="flow_kul_6_merge_sort">
    <mxGraphModel dx="4465" dy="2324" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" value="Flowchart 6 — Sorting: merge_sort (split in half → merge)" vertex="1">
          <mxGeometry height="34" width="787" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-2" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;" value="sort_group.py · built as recursion that splits in half until one item is left, unlike hash_table.py, which computes the position straight from the key, and unlike count_* in search.py, which walks the data once" vertex="1">
          <mxGeometry height="20" width="787" x="20" y="44" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" value="Start" vertex="1">
          <mxGeometry height="46" width="170" x="245" y="78" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" value="Receive items and a key function &lt;b&gt;as parameters&lt;/b&gt;&lt;br&gt;&lt;i&gt;imports no team member's file, stdlib only&lt;/i&gt;" vertex="1">
          <mxGeometry height="56" width="300" x="180" y="138" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" value="len(items) ≤ 1 ?" vertex="1">
          <mxGeometry height="86" width="230" x="215" y="208" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="&lt;b&gt;base case&lt;/b&gt;&lt;br&gt;return list(items) as is&lt;br&gt;&lt;i&gt;a single item is always sorted&lt;br&gt;this is where the recursion stops splitting&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="530" y="270" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="middle = len(items) // 2" vertex="1">
          <mxGeometry height="46" width="230" x="215" y="312" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;Split in half and call itself&lt;/b&gt;&lt;br&gt;left = merge_sort(items[:middle], key)&lt;br&gt;right = merge_sort(items[middle:], key)" vertex="1">
          <mxGeometry height="70" width="300" x="180" y="376" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" value="About log₂(n) levels deep&lt;br&gt;1,000 records ≈ 10 levels&lt;br&gt;&lt;i&gt;no risk of stack overflow&lt;/i&gt;" vertex="1">
          <mxGeometry height="62" width="220" x="530" y="380" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-10" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1f3a5f;" value="_merge(left, right, key) — merge two sorted halves into one · O(n)" vertex="1">
          <mxGeometry height="20" width="787" x="20" y="462" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="i=0 , j=0 , merged = []&amp;nbsp;" vertex="1">
          <mxGeometry height="46" width="230" x="215" y="492" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-12" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" value="i &amp;lt; len(left)&lt;br&gt;&lt;b&gt;and&lt;/b&gt; j &amp;lt; len(right) ?" vertex="1">
          <mxGeometry height="90" width="230" x="215" y="556" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;Append what is left of both sides&lt;/b&gt;&lt;br&gt;merged.extend(left[i:])&lt;br&gt;merged.extend(right[j:])&lt;br&gt;&lt;i&gt;the remaining side is already sorted, so it can be appended as is&lt;/i&gt;" vertex="1">
          <mxGeometry height="78" width="220" x="530" y="566" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-14" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" value="key(left[i]) &lt;b&gt;&amp;lt;=&lt;/b&gt; key(right[j]) ?" vertex="1">
          <mxGeometry height="96" width="230" x="215" y="664" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;Take from the left&lt;/b&gt;&lt;br&gt;merged.append(left[i])&lt;br&gt;i += 1" vertex="1">
          <mxGeometry height="70" width="185" x="15" y="682" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;Take from the right&lt;/b&gt;&lt;br&gt;merged.append(right[j])&lt;br&gt;j += 1" vertex="1">
          <mxGeometry height="70" width="220" x="530" y="682" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-17" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6b4423;" value="&lt;i&gt;Writing &amp;lt;= instead of &amp;lt; here is the one thing that makes this a &lt;b&gt;stable sort&lt;/b&gt;&lt;br&gt;on equal values, the left item is always taken first&lt;/i&gt;" vertex="1">
          <mxGeometry height="38" width="330" x="460" y="766" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="Return merged to the level above in the recursion to merge further (the whole block is sorted)" vertex="1">
          <mxGeometry height="60" width="230" x="215" y="860" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-19" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" value="End" vertex="1">
          <mxGeometry height="46" width="170" x="245" y="960" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-20" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f9f9f9;strokeColor=#cccccc;spacing=10;" value="&lt;b&gt;Why splitting in half and merging is faster than swapping pair by pair&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Splitting in half until one item is left gives &lt;b&gt;log₂(n) levels&lt;/b&gt;, and merging each level costs &lt;b&gt;O(n)&lt;/b&gt;, for &lt;b&gt;O(n log n)&lt;/b&gt; in total&lt;br&gt;• Bubble sort compares every pair over and over, so it is &lt;b&gt;O(n²)&lt;/b&gt; — measured on set D with 1,000 records, &lt;b&gt;merge sort is 34.6 times faster than bubble sort&lt;/b&gt;&lt;br&gt;• Writing &lt;b&gt;&amp;lt;= instead of &amp;lt;&lt;/b&gt; when comparing the left side makes it a &lt;b&gt;stable sort&lt;/b&gt;, so records with the same due_date keep their original order instead of being swapped for no reason&lt;br&gt;• It &lt;b&gt;always returns a new list and never changes the original&lt;/b&gt;, because someone else may hold the same list, just like sort_by_code in search.py&lt;br&gt;• The sorted list from this file is what &lt;b&gt;find_due_before (Neo's binary search)&lt;/b&gt; uses directly; if it were sorted wrongly, the halving would cut the wrong side &lt;b&gt;with no error at all&lt;/b&gt;" vertex="1">
          <mxGeometry height="130" width="787" x="20" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-21" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" target="buWZ9kO0xOohI7CN-Vdh-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-22" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" target="buWZ9kO0xOohI7CN-Vdh-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-23" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="buWZ9kO0xOohI7CN-Vdh-6" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-24" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" target="buWZ9kO0xOohI7CN-Vdh-7" value="No — can still split">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-25" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" target="buWZ9kO0xOohI7CN-Vdh-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-26" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" target="buWZ9kO0xOohI7CN-Vdh-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-27" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" target="buWZ9kO0xOohI7CN-Vdh-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-28" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="buWZ9kO0xOohI7CN-Vdh-13" value="No — one side is empty">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-29" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" target="buWZ9kO0xOohI7CN-Vdh-14" value="Yes — both sides still have items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-30" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="buWZ9kO0xOohI7CN-Vdh-15" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-31" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="buWZ9kO0xOohI7CN-Vdh-16" value="No">
          <mxGeometry relative="1" x="-0.0556" y="3" as="geometry">
            <mxPoint x="3" y="1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-32" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="buWZ9kO0xOohI7CN-Vdh-12" value="Compare the new heads">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="107" y="824" />
              <mxPoint x="8" y="824" />
              <mxPoint x="8" y="601" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-33" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="buWZ9kO0xOohI7CN-Vdh-12" value="Loop back">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="824" />
              <mxPoint x="8" y="824" />
              <mxPoint x="8" y="601" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-34" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="buWZ9kO0xOohI7CN-Vdh-18">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="605" />
              <mxPoint x="800" y="890" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-35" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" target="buWZ9kO0xOohI7CN-Vdh-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buWZ9kO0xOohI7CN-Vdh-36" edge="1" parent="1" source="buWZ9kO0xOohI7CN-Vdh-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="buWZ9kO0xOohI7CN-Vdh-19">
