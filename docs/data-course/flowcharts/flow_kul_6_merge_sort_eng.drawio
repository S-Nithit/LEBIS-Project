        <mxCell id="c7QVKBLfUE9yaJwH1Uqj-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="Entry point the system really calls: sort_by_due_date(items)&lt;br&gt;• drops records whose due_date is None first — unrented items have no due date, and None cannot be compared with text&lt;br&gt;• calls merge_sort with key = due_date&lt;br&gt;• hands the result to Neo's find_due_before, a binary search that works only on a sorted list&lt;br&gt;sort_by_available is the same merge_sort with key = available, so it is not drawn separately" vertex="1">
          <mxGeometry height="144" width="340" x="500" y="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>