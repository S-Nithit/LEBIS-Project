        <mxCell id="1EbR7DAvwTjFx6VMF4nU-16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="groups[status].append(item)" vertex="1">
