          <mxGeometry height="50" width="150" x="445" y="515" as="geometry" />
        </mxCell>
        <mxCell id="1EbR7DAvwTjFx6VMF4nU-15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="groups[category].append(item)" vertex="1">
