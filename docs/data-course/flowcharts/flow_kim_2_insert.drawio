<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Flowchart 2 — เพิ่มอุปกรณ์ (add_item + HashTable.insert)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110.0" y="10" width="620" height="34" as="geometry"/></mxCell><mxCell id="n3" value="เริ่ม" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="245.0" y="60" width="170" height="50" as="geometry"/></mxCell><mxCell id="n4" value="รับ record ใหม่&lt;br&gt;(code, name, total, available ...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="135" width="230" height="56" as="geometry"/></mxCell><mxCell id="n5" value="index.get(code)&lt;br&gt;มีรหัสนี้แล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="215" width="230" height="96" as="geometry"/></mxCell><mxCell id="n6" value="ปฏิเสธ: รหัสซ้ำ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="235" width="220" height="56" as="geometry"/></mxCell><mxCell id="n7" value="total ≥ 1 และ&lt;br&gt;0 ≤ available ≤ total?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="340" width="230" height="96" as="geometry"/></mxCell><mxCell id="n8" value="ปฏิเสธ: จำนวนไม่ถูกต้อง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="360" width="220" height="56" as="geometry"/></mxCell><mxCell id="n9" value="เติมฟิลด์ที่ขาดให้ครบ 8 ฟิลด์&lt;br&gt;items.append(record)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="470" width="230" height="56" as="geometry"/></mxCell><mxCell id="n10" value="_hash(code): polynomial rolling hash&lt;br&gt;h = (h × 31 + ord(ตัวอักษร)) mod 1e9+7&lt;br&gt;เลขถัง = h mod จำนวนถัง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180.0" y="555" width="300" height="70" as="geometry"/></mxCell><mxCell id="n11" value="ในโซ่ของถังนี้&lt;br&gt;มี code นี้แล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="655" width="230" height="96" as="geometry"/></mxCell><mxCell id="n12" value="แก้ค่าทับ (ใช้ตอนย้ายตำแหน่ง)&lt;br&gt;จำนวนข้อมูลเท่าเดิม" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="675" width="220" height="56" as="geometry"/></mxCell><mxCell id="n13" value="ถังนี้ว่าง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="780" width="230" height="96" as="geometry"/></mxCell><mxCell id="n14" value="ชน (collision)&lt;br&gt;collisions + 1&lt;br&gt;ต่อท้ายโซ่ (chaining)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="800" width="220" height="66" as="geometry"/></mxCell><mxCell id="n15" value="ใส่ (code, ตำแหน่ง) ลงถัง&lt;br&gt;size + 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215.0" y="910" width="230" height="56" as="geometry"/></mxCell><mxCell id="n16" value="load factor&lt;br&gt;= size ÷ ถัง &gt; 0.7?" style="rhombu