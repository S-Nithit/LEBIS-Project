# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — .env ไม่ขึ้น git
# สร้างค่าสุ่มด้วย:  openssl rand -hex 32

# ===== จำเป็นต้องมีทุกเครื่อง =====

# กุญแจที่ใช้เซ็น JWT ของระบบสมาชิก
# ห้ามใช้ค่าเดียวกับตอน deploy จริง และห้าม commit ค่าจริงลง repo
JWT_SECRET=

# บัญชีผู้ดูแลระบบที่ระบบจะสร้างให้ตอนสตาร์ท (ถ้าตั้งครบทั้งสองค่า)
# ไม่ตั้งก็รันได้ แค่จะไม่มีบัญชี admin ให้เข้าหน้าผู้ดูแลระบบ
# 🔴 ค่าบน production ต้องเป็นคนละค่ากับในเครื่อง
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== ไม่ต้องตั้งตอนรันในเครื่อง — มีไว้ให้รู้ว่าตอน deploy ต้องตั้งอะไรบ้าง =====
# รายละเอียดทั้งหมดอยู่ใน docs/deployment.md

# ค่าเชื่อมต่อฐานข้อมูลแบบสตริงเดียว (Railway ให้มาแบบนี้)
# ถ้าเว้นว่าง ระบบจะประกอบ URL จาก POSTGRES_* ที่ตั้งไว้ใน docker-compose.yaml แทน
DATABASE_URL=

# ใส่บัญชีทดสอบให้อัตโนมัติตอนสตาร์ท (true/false)
# ในเครื่องปล่อยว่างได้ ค่าเริ่มต้นคือ true · ตอน deploy จริงต้องเป็น false
SEED_DEMO_ACCOUNTS=

# URL ของ backend สำหรับให้ Next.js rewrite /api/* ไปหา
# ตัวนี้ตั้งที่ Vercel ไม่ได้ตั้งในไฟล์นี้ ถ้าเว้นว่างจะใช้ http://backend-api:8000 ของ compose
BACKEND_URL=
