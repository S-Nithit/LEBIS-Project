# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง  ->  cp .env.example .env
# ไฟล์ .env ห้าม commit เด็ดขาด (อยู่ใน .gitignore แล้ว)

# ---------- ฐานข้อมูล ----------
# ค่าเหล่านี้ใช้สร้าง container postgres ตอน docker compose up
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lebis

# backend คุยกับ db ผ่านเครือข่ายภายในของ compose จึงใช้ host ว่า "db" และพอร์ต 5432
# (ไม่ใช่ 5433 - 5433 คือพอร์ตที่เปิดออกมาให้เครื่องเราต่อจากข้างนอกเท่านั้น)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/lebis

# ---------- ความปลอดภัย ----------
# สุ่มใหม่เองด้วย: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS ----------
# frontend รันที่พอร์ต 3000 ถ้ามีหลาย origin ให้คั่นด้วยจุลภาค
CORS_ORIGINS=http://localhost:3000

# ---------- LINE Messaging API (ใช้ใน Phase 3 ยังไม่ต้องใส่ตอนนี้) ----------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ---------- ทั่วไป ----------
ENV=development
